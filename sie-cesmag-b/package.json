{
  "name": "sie-cesmag-b",
  "version": "0.0.0",
  "private": true,
  "description": "API (Express) del SIE CESMAG — capa entre el portal React y Supabase (Postgres + Auth + Storage).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate",
    "start": "tsx src/server.ts",
    "bootstrap:admin": "tsx scripts/crear-primer-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma": "^6.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "vitest-mock-extended": "^5.1.1"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  }
