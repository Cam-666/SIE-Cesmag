# Conexión a Supabase Postgres. DATABASE_URL usa el connection pooler
# (pgbouncer, puerto 6543) para las consultas normales de la app;
# DIRECT_URL usa la conexión directa (puerto 5432), necesaria para que
# Prisma pueda ejecutar migraciones. Ambas se obtienen en el dashboard de
# Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth + Storage (Project Settings → API).
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Puerto local del servidor de Express y URL del frontend (para armar los
# enlaces de restablecimiento de contraseña que se envían por correo).
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Clave compartida que debe mandar el script de Google Forms (Apps Script)
# en el encabezado X-Formulario-Clave al enviar una respuesta (RF-01) —
# no es una cuenta de usuario, así que no pasa por Supabase Auth.
FORMULARIO_CLAVE_SECRETA="<clave-secreta>"
