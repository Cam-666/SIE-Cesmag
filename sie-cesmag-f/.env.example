# URL base de la API del SIE. Copiar este archivo a .env.local y ajustar.
VITE_API_URL=http://localhost:4000/api

# "false" apunta al backend real (VITE_API_URL) en vez de los mocks (MSW).
# Los módulos que el backend todavía no tiene construidos fallarán en ese
# modo — es esperado mientras se sigue construyendo.
VITE_USE_MOCKS=true
