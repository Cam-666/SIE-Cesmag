# Plantilla de variables del backend (sie-cesmag-b). Copiar a `.env` y completar.
# Nunca subir `.env` a GitHub: está ignorado en .gitignore.

# Conexión a Supabase Postgres. DATABASE_URL usa el connection pooler (puerto 6543)
# para las consultas de la app; DIRECT_URL usa la conexión directa (puerto 5432),
# necesaria para que Prisma ejecute migraciones.
# Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<direct-host>:5432/postgres"

# Supabase Auth (Project Settings → API). La clave de servicio NUNCA va al frontend.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Puerto del servidor Express.
PORT=4000

# URL(s) del frontend desplegado. Varias separadas por coma. Solo estos orígenes
# pueden llamar a la API desde el navegador (CORS).
FRONTEND_URL="https://<tu-frontend>.vercel.app"
# Para desarrollo local, agregar también el origen del frontend, por ejemplo:
# FRONTEND_URL="https://<tu-frontend>.vercel.app,http://localhost:5173"

# Clave compartida que envía el script de Google Forms en el encabezado
# X-Formulario-Clave (RF-01). Generar una cadena larga y aleatoria.
FORMULARIO_CLAVE_SECRETA="<clave-secreta>"

# Correo transaccional (Brevo) para enlaces de restablecimiento y avisos.
BREVO_API_KEY="<brevo-api-key>"
BREVO_REMITENTE="<correo-remitente>"

# Google Drive (evidencias de entregables).
GOOGLE_CLIENT_ID="<client-id>"
GOOGLE_CLIENT_SECRET="<client-secret>"
GOOGLE_REFRESH_TOKEN="<refresh-token>"

# Correo alternativo por Gmail (solo si se usa en lugar de Brevo).
GMAIL_USER="<cuenta@gmail.com>"
GMAIL_APP_PASSWORD="<contraseña-de-aplicación>"
